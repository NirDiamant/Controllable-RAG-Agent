OPENAI_API_KEY=
GROQ_API_KEY=

# Multi-provider LLM support
# Set LLM_PROVIDER to switch between providers: "openai" (default) or "minimax"
LLM_PROVIDER=openai

# MiniMax configuration (required when LLM_PROVIDER=minimax)
# Get your API key from https://platform.minimaxi.com/
MINIMAX_API_KEY=
# Available models: MiniMax-M2.5 (default), MiniMax-M2.5-highspeed (204K context)
MINIMAX_MODEL=MiniMax-M2.5